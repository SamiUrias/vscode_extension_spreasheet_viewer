{
  "name": "spreadsheet-viewer",
  "displayName": "Spreadsheet Viewer by Samuel Urias",
  "publisher": "SamuelUrias",
  "description": "%extension.description%",
  "version": "0.0.3",
  "license": "MIT",
  "keywords": [
    "spreadsheet",
    "csv",
    "tsv",
    "xlsx",
    "ods",
    "table",
    "data viewer"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": ["onStartupFinished", "onLanguage:plaintext"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension-web.js",
  "contributes": {
    "commands": [
      {
        "command": "spreadsheet-viewer.open",
        "title": "%command.open%",
        "category": "Spreadsheet Viewer",
        "icon": "resources/spreadsheet.svg"
      },
      {
        "command": "spreadsheet-viewer.preview",
        "title": "%command.preview%",
        "category": "Spreadsheet Viewer",
        "icon": "resources/preview.svg"
      },
      {
        "command": "spreadsheet-viewer.previewBuffer",
        "title": "%command.previewBuffer%",
        "category": "Spreadsheet Viewer"
      },
      {
        "command": "spreadsheet-viewer.previewCsv",
        "title": "%command.previewCsv%",
        "category": "Spreadsheet Viewer"
      },
      {
        "command": "spreadsheet-viewer.resetView",
        "title": "%command.resetView%",
        "category": "Spreadsheet Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "spreadsheet-viewer.editor",
        "displayName": "Spreadsheet Viewer",
        "selector": [
          {
            "filenamePattern": "**/*.[cC][sS][vV]"
          },
          {
            "filenamePattern": "**/*.[tT][sS][vV]"
          },
          {
            "filenamePattern": "**/*.[tT][aA][bB]"
          },
          {
            "filenamePattern": "**/*.[xX][lL][sS][xX]"
          },
          {
            "filenamePattern": "**/*.[xX][lL][sS][mM]"
          },
          {
            "filenamePattern": "**/*.[oO][dD][sS]"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(csv|tsv|tab|xlsx|xlsm|ods)$/i",
          "group": "1_modification"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(csv|tsv|tab|xlsx|xlsm|ods)$/i",
          "group": "1_modification@2"
        },
        {
          "command": "spreadsheet-viewer.previewCsv",
          "when": "!explorerResourceIsFolder",
          "group": "1_modification@3"
        }
      ],
      "editor/title": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|xlsm|ods)$/i",
          "group": "navigation"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|xlsm|ods)$/i",
          "group": "navigation@2"
        },
        {
          "command": "spreadsheet-viewer.previewBuffer",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab)$/i",
          "group": "navigation@3"
        }
      ],
      "tabContext": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|xlsm|ods)$/i",
          "group": "1_modification"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|xlsm|ods)$/i",
          "group": "1_modification@2"
        },
        {
          "command": "spreadsheet-viewer.previewBuffer",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab)$/i",
          "group": "1_modification@3"
        },
        {
          "command": "spreadsheet-viewer.previewCsv",
          "when": "true",
          "group": "1_modification@4"
        }
      ],
      "commandPalette": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "true"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "true"
        },
        {
          "command": "spreadsheet-viewer.previewBuffer",
          "when": "true"
        },
        {
          "command": "spreadsheet-viewer.previewCsv",
          "when": "true"
      },
      {
        "command": "spreadsheet-viewer.resetView",
        "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "spreadsheet-viewer.open",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o",
        "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|xlsm|ods)$/i"
      }
    ],
    "configuration": {
      "title": "Spreadsheet Viewer",
      "properties": {
        "spreadsheet-viewer.csv.commentPrefix": {
          "type": "string",
          "default": "#",
          "description": "%config.csv.commentPrefix%"
        },
        "spreadsheet-viewer.stdin.openStdin": {
          "type": "boolean",
          "default": false,
          "description": "%config.stdin.openStdin%"
        },
        "spreadsheet-viewer.csv.firstRowHeader": {
          "type": "boolean",
          "default": true,
          "description": "%config.csv.firstRowHeader%"
        },
        "spreadsheet-viewer.csv.headerCase": {
          "type": "string",
          "enum": ["none", "upper", "lower"],
          "default": "none",
          "description": "%config.csv.headerCase%"
        },
        "spreadsheet-viewer.csv.showRowActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.csv.showRowActions%"
        },
        "spreadsheet-viewer.xlsx.showStructureActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.xlsx.showStructureActions%"
        },
        "spreadsheet-viewer.xlsx.allowFormulaEditing": {
          "type": "boolean",
          "default": true,
          "description": "%config.xlsx.allowFormulaEditing%"
        },
        "spreadsheet-viewer.xlsx.showFormulaAssistance": {
          "type": "boolean",
          "default": true,
          "description": "%config.xlsx.showFormulaAssistance%"
        },
        "spreadsheet-viewer.xlsx.showFormulaFillActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.xlsx.showFormulaFillActions%"
        },
        "spreadsheet-viewer.xlsx.showTableActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.xlsx.showTableActions%"
        },
        "spreadsheet-viewer.xlsx.showSheetActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.xlsx.showSheetActions%"
        },
        "spreadsheet-viewer.xlsx.showStyleActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.xlsx.showStyleActions%"
        },
        "spreadsheet-viewer.view.restoreState": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.restoreState%"
        },
        "spreadsheet-viewer.view.showResetButton": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.showResetButton%"
        },
        "spreadsheet-viewer.view.showClearSortButton": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.showClearSortButton%"
        },
        "spreadsheet-viewer.view.showCopyButtons": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.showCopyButtons%"
        },
        "spreadsheet-viewer.view.showMoveActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.showMoveActions%"
        },
        "spreadsheet-viewer.view.showFillActions": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.showFillActions%"
        },
        "spreadsheet-viewer.view.showDisplayModeButton": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.showDisplayModeButton%"
        },
        "spreadsheet-viewer.view.showWorkbookAppearance": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.showWorkbookAppearance%"
        },
        "spreadsheet-viewer.edit.saveOnCommit": {
          "type": "boolean",
          "default": true,
          "description": "%config.edit.saveOnCommit%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "test:formulas": "node scripts/test-formulas.js",
    "test:localization": "npm run compile-tests && node scripts/test-localization.js",
    "check:localization": "node scripts/check-localization.js",
    "test:ml-01b-contracts": "npm run compile-tests && node scripts/test-ml-01b-contracts.js",
    "test:storage-node-conflict": "npm run compile-tests && node scripts/test-storage-node-conflict.js",
    "test:formula-edits": "npm run compile-tests && node scripts/test-formula-edits.js",
    "test:formula-fill-host": "npm run package && npm run compile-tests && node scripts/test-formula-fill-host.js",
    "test:clipboard": "npm run compile-tests && node scripts/test-clipboard.js",
    "test:edit-transactions": "npm run compile-tests && node scripts/test-edit-transactions.js",
    "test:edit-batch-host": "npm run compile-tests && node scripts/test-edit-batch-host.js",
    "test:csv-row-operations": "npm run compile-tests && node scripts/test-csv-row-operations.js",
    "test:presentation": "npm run compile-tests && node scripts/test-presentation.js",
    "test:save-coordinator": "npm run compile-tests && node scripts/test-save-coordinator.js",
    "test:recovery": "npm run compile-tests && node scripts/test-recovery-lifecycle.js",
    "test:cell-deltas": "npm run compile-tests && node scripts/test-cell-deltas.js",
    "test:grid-layout": "npm run compile-tests && node scripts/test-grid-layout.js",
    "test:csv-dialect": "npm run compile-tests && node scripts/test-csv-dialect.js",
    "test:filesystem-capability": "npm run compile-tests && node scripts/test-filesystem-capability.js",
    "test:runtime": "npm run compile-tests && node scripts/test-runtime.js",
    "test:web-target": "npm run package && node scripts/test-web-target.js",
    "test:xlsm-format": "npm run compile-tests && node scripts/test-xlsm-format.js",
    "test:fill": "npm run compile-tests && node scripts/test-fill.js",
    "test:xlsx-tables": "npm run compile-tests && node scripts/test-xlsx-tables.js",
    "test:xlsx-sheets": "npm run compile-tests && node scripts/test-xlsx-sheets.js",
    "test:xlsx-structure": "npm run compile-tests && node scripts/test-xlsx-structure.js",
    "test:move-range": "npm run compile-tests && node scripts/test-move-range.js",
    "test:xlsx-styles": "npm run compile-tests && node scripts/test-xlsx-styles.js",
    "test:untrusted": "npm run compile-tests && node scripts/test-untrusted-host.js",
    "test:formula-references": "node scripts/test-formulas.js --reference",
		"benchmark:performance": "npm run compile-tests && node --expose-gc scripts/benchmark-performance.js",
    "test:save-lifecycle": "npm run compile-tests && node scripts/test-save-lifecycle.js",
    "test:hot-exit": "npm run compile-tests && node scripts/test-hot-exit.js",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && npm run check-types:webview",
    "check-types:webview": "tsc --noEmit --project tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/papaparse": "^5.5.2",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "ts-loader": "9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "5.104.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "formualizer": "0.10.1",
    "papaparse": "^5.7.0",
    "ssf": "https://cdn.sheetjs.com/ssf-0.11.3/ssf-0.11.3.tgz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SamiUrias/vscode_extension_spreasheet_viewer.git"
  }
}
