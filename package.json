{
  "name": "spreadsheet-viewer",
  "displayName": "Spreadsheet Viewer by Samuel Urias",
  "publisher": "SamuelUrias",
  "description": "View and edit CSV, TSV, TAB, XLSX, and ODS spreadsheets in VS Code, with raw values, search, sorting, filters, and save-to-file support.",
  "version": "0.0.1",
  "license": "MIT",
  "keywords": [
    "spreadsheet",
    "csv",
    "tsv",
    "xlsx",
    "ods",
    "table",
    "data viewer"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": ["onStartupFinished", "onLanguage:plaintext"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spreadsheet-viewer.open",
        "title": "Abrir en Spreadsheet Viewer",
        "category": "Spreadsheet Viewer",
        "icon": "resources/spreadsheet.svg"
      },
      {
        "command": "spreadsheet-viewer.preview",
        "title": "Vista previa de hoja",
        "category": "Spreadsheet Viewer",
        "icon": "resources/preview.svg"
      },
      {
        "command": "spreadsheet-viewer.previewBuffer",
        "title": "Vista previa del buffer CSV/TSV/TAB",
        "category": "Spreadsheet Viewer"
      },
      {
        "command": "spreadsheet-viewer.previewCsv",
        "title": "Vista previa como CSV…",
        "category": "Spreadsheet Viewer"
      },
      {
        "command": "spreadsheet-viewer.resetView",
        "title": "Restablecer vista de hoja",
        "category": "Spreadsheet Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "spreadsheet-viewer.editor",
        "displayName": "Spreadsheet Viewer",
        "selector": [
          {
            "filenamePattern": "**/*.[cC][sS][vV]"
          },
          {
            "filenamePattern": "**/*.[tT][sS][vV]"
          },
          {
            "filenamePattern": "**/*.[tT][aA][bB]"
          },
          {
            "filenamePattern": "**/*.[xX][lL][sS][xX]"
          },
          {
            "filenamePattern": "**/*.[oO][dD][sS]"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(csv|tsv|tab|xlsx|ods)$/i",
          "group": "1_modification"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(csv|tsv|tab|xlsx|ods)$/i",
          "group": "1_modification@2"
        },
        {
          "command": "spreadsheet-viewer.previewCsv",
          "when": "!explorerResourceIsFolder",
          "group": "1_modification@3"
        }
      ],
      "editor/title": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|ods)$/i",
          "group": "navigation"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|ods)$/i",
          "group": "navigation@2"
        },
        {
          "command": "spreadsheet-viewer.previewBuffer",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab)$/i",
          "group": "navigation@3"
        }
      ],
      "tabContext": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|ods)$/i",
          "group": "1_modification"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|ods)$/i",
          "group": "1_modification@2"
        },
        {
          "command": "spreadsheet-viewer.previewBuffer",
          "when": "resourceExtname =~ /\\.(csv|tsv|tab)$/i",
          "group": "1_modification@3"
        },
        {
          "command": "spreadsheet-viewer.previewCsv",
          "when": "true",
          "group": "1_modification@4"
        }
      ],
      "commandPalette": [
        {
          "command": "spreadsheet-viewer.open",
          "when": "true"
        },
        {
          "command": "spreadsheet-viewer.preview",
          "when": "true"
        },
        {
          "command": "spreadsheet-viewer.previewBuffer",
          "when": "true"
        },
        {
          "command": "spreadsheet-viewer.previewCsv",
          "when": "true"
      },
      {
        "command": "spreadsheet-viewer.resetView",
        "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "spreadsheet-viewer.open",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o",
        "when": "resourceExtname =~ /\\.(csv|tsv|tab|xlsx|ods)$/i"
      }
    ],
    "configuration": {
      "title": "Spreadsheet Viewer",
      "properties": {
        "spreadsheet-viewer.csv.commentPrefix": {
          "type": "string",
          "default": "#",
          "description": "Prefijo que identifica comentarios CSV al inicio de un registro. Usa una cadena vacía para desactivar los comentarios."
        },
        "spreadsheet-viewer.stdin.openStdin": {
          "type": "boolean",
          "default": false,
          "description": "Abre automáticamente una vista previa de lectura para el buffer CSV compatible creado con la entrada estándar de VS Code (code -)."
        },
        "spreadsheet-viewer.csv.firstRowHeader": {
          "type": "boolean",
          "default": true,
          "description": "Usa la primera fila de datos como etiqueta visual de las columnas CSV."
        },
        "spreadsheet-viewer.csv.headerCase": {
          "type": "string",
          "enum": ["none", "upper", "lower"],
          "default": "none",
          "description": "Transformación visual aplicada a las etiquetas de encabezado CSV."
        },
        "spreadsheet-viewer.csv.showRowActions": {
          "type": "boolean",
          "default": true,
          "description": "Muestra acciones para insertar, añadir y eliminar registros CSV en el editor."
        },
        "spreadsheet-viewer.xlsx.showStructureActions": {
          "type": "boolean",
          "default": true,
          "description": "Muestra las acciones para insertar y eliminar filas o columnas en libros XLSX compatibles."
        },
        "spreadsheet-viewer.xlsx.allowFormulaEditing": {
          "type": "boolean",
          "default": true,
          "description": "Permite crear y editar fórmulas XLSX mediante el modo explícito de edición de fórmula."
        },
        "spreadsheet-viewer.xlsx.showFormulaAssistance": {
          "type": "boolean",
          "default": true,
          "description": "Muestra sugerencias de funciones probadas y la inserción explícita de referencias XLSX."
        },
        "spreadsheet-viewer.view.restoreState": {
          "type": "boolean",
          "default": true,
          "description": "Restaura y guarda selección, scroll, búsqueda y tamaños por archivo y hoja."
        },
        "spreadsheet-viewer.view.showResetButton": {
          "type": "boolean",
          "default": true,
          "description": "Muestra el botón para restablecer la vista de la hoja."
        },
        "spreadsheet-viewer.view.showClearSortButton": {
          "type": "boolean",
          "default": true,
          "description": "Muestra el botón para quitar todos los criterios de orden activos."
        },
        "spreadsheet-viewer.view.showCopyButtons": {
          "type": "boolean",
          "default": true,
          "description": "Muestra los controles para copiar la selección como TSV."
        },
        "spreadsheet-viewer.view.showDisplayModeButton": {
          "type": "boolean",
          "default": true,
          "description": "Muestra el botón para alternar entre valores crudos y formatos numéricos de Excel en XLSX."
        },
        "spreadsheet-viewer.view.showWorkbookAppearance": {
          "type": "boolean",
          "default": true,
          "description": "Aplica estilos básicos y celdas combinadas de XLSX/ODS en la cuadrícula."
        },
        "spreadsheet-viewer.edit.saveOnCommit": {
          "type": "boolean",
          "default": true,
          "description": "Guarda automáticamente cada cambio confirmado; al desactivarlo, guarda con Ctrl/Cmd+S."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "test:formulas": "node scripts/test-formulas.js",
    "test:formula-edits": "npm run compile-tests && node scripts/test-formula-edits.js",
    "test:cell-deltas": "npm run compile-tests && node scripts/test-cell-deltas.js",
    "test:grid-layout": "npm run compile-tests && node scripts/test-grid-layout.js",
    "test:csv-dialect": "npm run compile-tests && node scripts/test-csv-dialect.js",
    "test:formula-references": "node scripts/test-formulas.js --reference",
		"benchmark:performance": "npm run compile-tests && node --expose-gc scripts/benchmark-performance.js",
    "test:save-lifecycle": "npm run compile-tests && node scripts/test-save-lifecycle.js",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && npm run check-types:webview",
    "check-types:webview": "tsc --noEmit --project tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/papaparse": "^5.5.2",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "ts-loader": "9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "5.104.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "formualizer": "0.10.1",
    "papaparse": "^5.7.0",
    "ssf": "https://cdn.sheetjs.com/ssf-0.11.3/ssf-0.11.3.tgz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SamiUrias/vscode_extension_spreasheet_viewer.git"
  }
}
